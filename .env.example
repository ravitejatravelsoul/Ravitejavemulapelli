# No environment variables are required to run the public portfolio.
# The variables below are only for Teja's AI Office (/office/**) — see
# docs/ai-office/08-security-plan.md. Copy this file to .env.local and fill
# in real values there; .env.local is already gitignored.

# Signs and verifies the AI Office owner session cookie. Must be at least
# 32 bytes long or sign-in will fail closed (no session can be created or
# verified) — this is enforced in code, not just a suggestion. Generate a
# safely-sized one with:
#   openssl rand -base64 32
OFFICE_SESSION_SECRET=

# The one owner account allowed to sign in at /office/login.
OFFICE_OWNER_EMAIL=

# A "salt:hash" pair (both hex), never the plaintext password. Generate it
# locally with:
#   node scripts/ai-office-hash-password.mjs "your-password-here"
# and paste the printed value below.
OFFICE_OWNER_PASSWORD_HASH=
