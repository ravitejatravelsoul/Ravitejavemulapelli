# No environment variables are required to run the public portfolio.
# The variables below are only for Teja's AI Office (/office/**) — see
# docs/ai-office/08-security-plan.md. Copy this file to .env.local and fill
# in real values there; .env.local is already gitignored.

# Signs and verifies the AI Office owner session cookie. Must be at least
# 32 bytes long or sign-in will fail closed (no session can be created or
# verified) — this is enforced in code, not just a suggestion. Generate a
# safely-sized one with:
#   openssl rand -base64 32
OFFICE_SESSION_SECRET=

# The one owner account allowed to sign in at /office/login.
OFFICE_OWNER_EMAIL=

# A "salt:hash" pair (both hex), never the plaintext password. Generate it
# locally with:
#   node scripts/ai-office-hash-password.mjs "your-password-here"
# and paste the printed value below.
OFFICE_OWNER_PASSWORD_HASH=

# Controlled Claude LIVE pilot (optional) — only needed to let a HYBRID/
# CLAUDE_ONLY project's paid-eligible roles actually call Claude. Without
# these, AI Office runs exactly as before (LOCAL_ONLY / SIMULATED / Ollama
# projects are entirely unaffected) and any Claude-routed role shows a
# clean "not configured" blocked state instead of erroring. Never paste a
# real key into this file — it's tracked in git; put real values only in
# your local, gitignored .env.local.

# Your Anthropic API key (starts with "sk-ant-"). Required for any real
# Claude call; the server never logs, persists, or returns this value.
ANTHROPIC_API_KEY=

# Both required together (USD per 1,000,000 tokens) — real usage cost is
# always computed from these plus the API's own real returned token
# counts, never a hardcoded number. Look up current pricing for the model
# you configure at https://www.anthropic.com/pricing before setting these.
ANTHROPIC_INPUT_PRICE_PER_MTOK=
ANTHROPIC_OUTPUT_PRICE_PER_MTOK=

# Optional — which Claude model to call. Defaults to a current Claude
# model if unset; set this explicitly to pin a specific model instead.
ANTHROPIC_MODEL=

# Optional — per-call timeout in milliseconds. Defaults to 120000 (2
# minutes) if unset.
ANTHROPIC_TIMEOUT_MS=

# Free multi-model orchestration phase (optional) — dynamic FREE-model
# routing across Groq/Gemini/OpenRouter/Ollama for a project that opts
# into "Free Multi-Model Orchestration" on the New Project form. Without
# any of these, AI Office runs exactly as before. Never paste a real key
# into this file — set real values only in your local, gitignored
# .env.local.

# Set to "false" to disable Claude selection/calls entirely, regardless
# of any project's AI policy (even CLAUDE_ONLY) — a global kill-switch,
# independent of whether ANTHROPIC_API_KEY above is even configured.
# Unset (or any value other than the literal string "false") preserves
# the existing, already-approved Claude behavior.
AI_OFFICE_CLAUDE_ENABLED=

# Groq (free tier) — https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter (free ":free"-suffixed models) — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Human Escalation (optional) — lets AI Office reach the owner by phone/SMS
# when real action is required. Without any of this set, the office runs
# exactly as before: the owner's notification policy defaults to OFF (fully
# in-app), so nothing here is ever contacted. Never commit a real phone
# number, account SID, or auth token — set real values only in your local,
# gitignored .env.local.

# "mock" (default) or "twilio". Only the literal value "twilio" ever
# selects a real provider — Twilio credentials being present is not
# enough on its own. The mock provider proves the entire flow (call, SMS
# fallback, approve/reject, expiry, rate limiting) with zero telephony
# account, zero network calls, and zero cost.
COMMUNICATION_PROVIDER=mock

# E.164 format, e.g. +15551234567. Required for any real call/SMS to go
# out; with this unset, the escalation service records a real
# "no phone configured" outcome instead of silently doing nothing.
OWNER_PHONE_NUMBER=

# IANA timezone (e.g. America/Chicago) — used for quiet-hours and call-
# window checks. Also configurable from Settings once signed in; this is
# only the fallback for a fresh, never-configured office.
OWNER_TIMEZONE=

# Only read when COMMUNICATION_PROVIDER=twilio. Never logged, never
# persisted to the database, never returned by any API.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# The publicly reachable base URL of this deployment — required for a
# real Twilio call to ever place successfully: the TwiML <Gather> needs
# it to build the signed callback URL the caller's keypress posts back
# to. Missing this makes a real placeCall() fail closed (falling back to
# SMS) rather than placing a call nobody can ever respond to. Irrelevant
# to the mock provider.
OFFICE_PUBLIC_BASE_URL=

# Owner assistant display name (Part P). Purely cosmetic — defaults to
# "Teja" if unset.
OWNER_ASSISTANT_NAME=

# Required for Groq/Gemini inference: confirm the account has no paid billing,
# then supply current free chat model IDs (comma separated; no baked-in catalog).
AI_OFFICE_GROQ_FREE_TIER_CONFIRMED=false
AI_OFFICE_GROQ_FREE_MODELS=
AI_OFFICE_GEMINI_FREE_TIER_CONFIRMED=false
AI_OFFICE_GEMINI_FREE_MODELS=

# Models whose provider documents JSON Schema support (optional)
AI_OFFICE_GROQ_JSON_SCHEMA_MODELS=

# Optional provider-supported reasoning effort for configured models
AI_OFFICE_GROQ_REASONING_EFFORT=
