# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
playwright-report/
test-results/
artifacts/
screenshots/
videos/
downloads/

# next.js
/.next/
/out/
/dist/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.crt
*.p12
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.db
*.db-shm
*.db-wal
*.db-journal

# AI Office local SQLite database (lib/ai-office/db/paths.ts) — the *.db
# pattern above already covers the main file; this directory entry is
# belt-and-suspenders in case the DB path or its sidecar files ever
# change shape.
/.data/

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.tmp
*.cache

# env files
.env*
!.env.example

# vercel
.vercel/

# editor / IDE
.vscode/settings.json
.idea/

# claude code local settings
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# raw/original asset staging — pre-production working files, not shipped;
# processed, optimized versions of everything here already live in public/
/portfolio-assets/

# private planning/ops notes — for the site owner, not public consumption
# (LAUNCH.md says so explicitly; the others are unbuilt future-feature specs)
/ADMIN_SPEC.md
/CMS_ARCHITECTURE.md
/FIREBASE_MIGRATION.md
/LAUNCH.md
/MEDIA_GUIDE.md

# AI coding agent instructions — local tooling config, not project
# documentation; provides no value to a recruiter/contributor reading the repo
/AGENTS.md
/CLAUDE.md

# authoring/wiring notes inside public/ — instructions for the site owner on
# adding media later; not meant to be deployed as publicly servable files
public/**/README.txt
public/**/MEDIA_SPEC.md

# unprocessed source logos — superseded by the generated cover/logo/thumbnail
# assets actually referenced in content; never linked to from the site
public/**/*-original.*
public/projects/chillpay/ChillPay Icon.jpg

# one-time source images used to generate the actual served icons
# (favicon.ico, icon-192/512.png, apple-touch-icon.png, icon-maskable-512.png)
# — the generated outputs are what's committed and served; these inputs
# aren't referenced by the app at runtime
public/rv-favicon-source-512.png
public/rv-monogram-square.png
