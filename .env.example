# No environment variables are required to run the public portfolio.
# The variables below are only for Teja's AI Office (/office/**) — see
# docs/ai-office/08-security-plan.md. Copy this file to .env.local and fill
# in real values there; .env.local is already gitignored.

# Signs and verifies the AI Office owner session cookie. Must be at least
# 32 bytes long or sign-in will fail closed (no session can be created or
# verified) — this is enforced in code, not just a suggestion. Generate a
# safely-sized one with:
#   openssl rand -base64 32
OFFICE_SESSION_SECRET=

# The one owner account allowed to sign in at /office/login.
OFFICE_OWNER_EMAIL=

# A "salt:hash" pair (both hex), never the plaintext password. Generate it
# locally with:
#   node scripts/ai-office-hash-password.mjs "your-password-here"
# and paste the printed value below.
OFFICE_OWNER_PASSWORD_HASH=

# Controlled Claude LIVE pilot (optional) — only needed to let a HYBRID/
# CLAUDE_ONLY project's paid-eligible roles actually call Claude. Without
# these, AI Office runs exactly as before (LOCAL_ONLY / SIMULATED / Ollama
# projects are entirely unaffected) and any Claude-routed role shows a
# clean "not configured" blocked state instead of erroring. Never paste a
# real key into this file — it's tracked in git; put real values only in
# your local, gitignored .env.local.

# Your Anthropic API key (starts with "sk-ant-"). Required for any real
# Claude call; the server never logs, persists, or returns this value.
ANTHROPIC_API_KEY=

# Both required together (USD per 1,000,000 tokens) — real usage cost is
# always computed from these plus the API's own real returned token
# counts, never a hardcoded number. Look up current pricing for the model
# you configure at https://www.anthropic.com/pricing before setting these.
ANTHROPIC_INPUT_PRICE_PER_MTOK=
ANTHROPIC_OUTPUT_PRICE_PER_MTOK=

# Optional — which Claude model to call. Defaults to a current Claude
# model if unset; set this explicitly to pin a specific model instead.
ANTHROPIC_MODEL=

# Optional — per-call timeout in milliseconds. Defaults to 120000 (2
# minutes) if unset.
ANTHROPIC_TIMEOUT_MS=
